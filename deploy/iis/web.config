<?xml version="1.0" encoding="utf-8"?>
<!--
  DBX Web on IIS using HttpPlatformHandler (IIS owns the dbx-web.exe process).

  This is a template. deploy.ps1 substitutes the DBX_ROOT and DBX_BASE_PATH tokens and
  writes the result to <root>\site\web.config. If you copy it by hand, replace those
  tokens yourself.

  Requirements:
    - IIS 8+ with the HttpPlatformHandler module installed
      https://www.iis.net/downloads/microsoft/httpplatformhandler
    - WebSocket Protocol feature enabled (needed by /api/redis/pubsub/ws).
      Do not set <webSocket> here: that section is locked at the server level and the
      default is already enabled.
-->
<configuration>
  <system.webServer>
    <modules>
      <!-- Only needed when the WebDAV feature is installed. Delete this line if the
           site returns HTTP 500.19. -->
      <remove name="WebDAVModule" />
    </modules>

    <handlers>
      <!-- Delete this line if the site returns HTTP 500.19. -->
      <remove name="WebDAV" />
      <!-- A distinct name avoids colliding with a server-level handler mapping.
           responseBufferLimit="0" keeps Server-Sent Events (exports, imports, AI,
           transfers) unbuffered. -->
      <add name="dbx-web" path="*" verb="*" modules="httpPlatformHandler"
           resourceType="Unspecified" responseBufferLimit="0" />
    </handlers>

    <httpPlatform processPath="{{DBX_ROOT}}\bin\dbx-web.exe"
                  arguments=""
                  startupTimeLimit="60"
                  startupRetryCount="3"
                  rapidFailsPerMinute="10"
                  requestTimeout="02:00:00"
                  stdoutLogEnabled="true"
                  stdoutLogFile="{{DBX_ROOT}}\logs\stdout">
      <environmentVariables>
        <!-- HttpPlatformHandler picks the port and passes it through this expansion. -->
        <environmentVariable name="DBX_PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="DBX_STATIC_DIR" value="{{DBX_ROOT}}\static" />
        <!-- Always set this: without it DBX falls back to $HOME\.dbx-web, which IIS
             worker processes do not have. -->
        <environmentVariable name="DBX_DATA_DIR" value="{{DBX_ROOT}}\data" />
        <!-- The password is intentionally unset: create it on the first-run setup
             page. To preset it instead, uncomment the next line and use your own
             value. Never ship a placeholder password.
        <environmentVariable name="DBX_PASSWORD" value="CHANGE-ME" />
        -->
        <!-- Keep requestLimits.maxAllowedContentLength below at or above this value. -->
        <environmentVariable name="DBX_MAX_UPLOAD_MB" value="1024" />
        <environmentVariable name="RUST_LOG" value="dbx_web=info,tower_http=info" />
{{DBX_BASE_PATH}}
        <!-- Optional: point at a JRE if you do not want the Driver Manager to
             download one. -->
        <!-- <environmentVariable name="JAVA_HOME" value="C:\Program Files\Eclipse Adoptium\jre-21" /> -->
      </environmentVariables>
    </httpPlatform>

    <security>
      <requestFiltering>
        <!-- IIS default is 30 MB (30000000). Keep at or above DBX_MAX_UPLOAD_MB. -->
        <requestLimits maxAllowedContentLength="2147483648" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
